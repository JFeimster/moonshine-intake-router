# HubSpot
# Create a HubSpot private app token with contact and engagement/note permissions.
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_OWNER_ID=

# Notion
# Use an internal integration token with access to the Partner Applicants CRM database.
NOTION_API_KEY=
NOTION_PARTNER_APPLICANTS_DATA_SOURCE_ID=2484bc1b-d63c-80ff-804e-000be60930c0

# Tally
# Use this to validate incoming webhook requests.
# Preferred: send as x-tally-secret header if supported.
# Fallback: append ?secret=VALUE to the Tally webhook URL.
TALLY_WEBHOOK_SECRET=
